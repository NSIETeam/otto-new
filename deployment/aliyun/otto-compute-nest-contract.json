{
  "format": "otto-aliyun-compute-nest-contract-v1",
  "provider": "aliyun-compute-nest",
  "realDeploymentEnabled": false,
  "templateVersion": "0.3.0-local-preview",
  "supportedRegions": [
    "cn-hangzhou",
    "cn-shanghai",
    "cn-beijing",
    "cn-shenzhen"
  ],
  "parameters": {
    "allowed": [
      "region",
      "zone",
      "secondaryZone",
      "plan",
      "enterpriseDisplayName",
      "domainMode",
      "domainName"
    ],
    "systemManaged": [
      "deploymentId",
      "orderId",
      "idempotencyKey",
      "templateVersion",
      "ottoImageId",
      "databaseCredentialRef",
      "cacheCredentialRef",
      "dnsZoneName",
      "dnsRecordRr",
      "tlsCertificateId"
    ],
    "forbidden": [
      "password",
      "secret",
      "accessKey",
      "accessKeySecret",
      "license",
      "token",
      "privateKey",
      "databaseUrl",
      "redisUrl",
      "ossEndpoint"
    ]
  },
  "plans": {
    "trial": {
      "availabilityZones": 1,
      "statelessServers": 1,
      "postgres": {
        "public": false,
        "highAvailability": false,
        "backupRetentionDays": 7
      },
      "tair": { "public": false, "highAvailability": false },
      "oss": { "public": false, "versioning": true, "sseKms": true }
    },
    "standard": {
      "availabilityZones": 2,
      "statelessServers": 2,
      "postgres": {
        "public": false,
        "highAvailability": true,
        "backupRetentionDays": 14
      },
      "tair": { "public": false, "highAvailability": true },
      "oss": { "public": false, "versioning": true, "sseKms": true }
    },
    "ha": {
      "availabilityZones": 2,
      "statelessServers": 2,
      "postgres": {
        "public": false,
        "highAvailability": true,
        "backupRetentionDays": 30
      },
      "tair": { "public": false, "highAvailability": true },
      "oss": { "public": false, "versioning": true, "sseKms": true }
    }
  },
  "network": {
    "publicPorts": [443],
    "redirectPorts": [80],
    "privateResources": ["ottoServer", "postgres", "tair", "kms", "secrets"],
    "tls": { "minimumVersion": "1.2", "httpsRequired": true, "hsts": true },
    "ssh": { "defaultEnabled": false }
  },
  "templates": {
    "stage": "local-preview",
    "generatedFrom": "deployment/aliyun/plan-definitions.json",
    "files": {
      "trial": "deployment/aliyun/templates/ros/trial.json",
      "standard": "deployment/aliyun/templates/ros/standard.json",
      "ha": "deployment/aliyun/templates/ros/high-availability.json"
    },
    "requiredResourceTypes": [
      "ALIYUN::ECS::VPC",
      "ALIYUN::ECS::VSwitch",
      "ALIYUN::ECS::SecurityGroup",
      "ALIYUN::ECS::InstanceGroup",
      "ALIYUN::RDS::DBInstance",
      "ALIYUN::REDIS::Instance",
      "ALIYUN::OSS::Bucket",
      "ALIYUN::KMS::Key",
      "ALIYUN::RAM::Role",
      "ALIYUN::ALB::LoadBalancer",
      "ALIYUN::ALB::ServerGroup",
      "ALIYUN::ALB::BackendServerAttachment",
      "ALIYUN::ALB::Listener",
      "ALIYUN::DNS::DomainRecord"
    ]
  },
  "outputs": {
    "allowed": [
      "deploymentId",
      "orderId",
      "templateVersion",
      "vpcId",
      "serverInstanceIds",
      "databaseInstanceId",
      "cacheInstanceId",
      "ossBucketRef",
      "kmsKeyRef",
      "privateEndpoints",
      "publicHttpsOrigin",
      "loadBalancerDnsName"
    ],
    "forbidden": [
      "password",
      "secretValue",
      "accessKeySecret",
      "license",
      "privateKey",
      "connectionString"
    ]
  },
  "secrets": {
    "delivery": "secrets-manager-kms-reference",
    "plaintextAllowed": false,
    "missingDependencyAction": "fail-closed"
  },
  "idempotency": {
    "requiredFields": [
      "orderId",
      "deploymentId",
      "idempotencyKey",
      "templateVersion"
    ],
    "replayMustNotCreateResources": true
  },
  "publicEntry": {
    "provider": "aliyun-alb",
    "internetFacing": true,
    "availabilityZones": 2,
    "listenerPorts": [443],
    "backend": {
      "protocol": "HTTP",
      "port": 7777,
      "healthPath": "/enterprise/health",
      "allowedSourceCidrs": ["10.42.10.0/24", "10.42.11.0/24"]
    },
    "tlsSecurityPolicy": "tls_cipher_policy_1_2_strict_with_1_3",
    "certificateDelivery": "existing-cas-certificate-id",
    "certificatePrivateKeyTemplateInputAllowed": false,
    "dns": { "recordType": "CNAME", "zoneMustBelongToDeployingAccount": true }
  },
  "states": {
    "initial": "purchased",
    "terminal": ["healthy", "failed", "rolled_back"],
    "transitions": {
      "purchased": ["provisioning", "failed"],
      "provisioning": ["infrastructure_ready", "failed", "rolling_back"],
      "infrastructure_ready": ["installing", "failed", "rolling_back"],
      "installing": ["activating", "failed", "rolling_back"],
      "activating": ["initializing", "failed", "rolling_back"],
      "initializing": ["healthy", "failed", "rolling_back"],
      "healthy": ["installing", "rolling_back"],
      "failed": ["rolling_back"],
      "rolling_back": ["rolled_back", "failed"],
      "rolled_back": ["provisioning", "failed"]
    }
  },
  "evidence": {
    "realCloudRunRequiredForCompletion": true,
    "localContractValidationIsNotStagingEvidence": true,
    "remainingCloudIssues": [
      "CLOUD-02",
      "CLOUD-03",
      "CLOUD-04",
      "CLOUD-05",
      "QA-10"
    ]
  }
}
